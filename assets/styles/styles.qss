QMainWindow {
    background-color: #f5f5f5;
    font-family: Vazir, Arial;
}

QTabWidget::pane {
    border: 1px solid #ccc;
    border-radius: 5px;
}

QPushButton {
    background-color: #4CAF50;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-family: Vazir, Arial;
}

QPushButton:hover {
    background-color: #45a049;
}

QTableWidget {
    background-color: white;
    color: black;
    font-family: Vazir, Arial;
    border: 1px solid #ddd;
    border-radius: 5px;
}

/* ------------------------------------------------------------------
   تقویم شمسی (PersianCalendarWidget)
   نکته: از نسخه ۳.۰ تقویم، استایل کامل خودش را داخل
   ui/components/custom_widgets.py اعمال می‌کند (شیوه‌نامهٔ محلی بر
   شیوه‌نامهٔ سراسری مقدم است). قواعد قدیمی تیرهٔ
   «PersianCalendarWidget QPushButton { background-color: #666 }» که
   باعث ناخوانا شدن پاپ‌آپ انتخاب تاریخ در تم تاریک ویندوز می‌شدند،
   حذف شدند.
------------------------------------------------------------------ */

/* ------------------------------------------------------------------
   جعبه‌پیام‌ها (QMessageBox)
   نکته مهم: در ویندوز با «تم تاریک»، جعبه‌پیام از پالت سیستم
   رنگ می‌گیرد؛ متن تیره روی پس‌زمینه تیره نامرئی می‌شد.
   با تعیین صریح پس‌زمینه روشن و رنگ متن تیره، پیام‌ها همیشه
   خوانا می‌مانند — مستقل از تم سیستم‌عامل.
   (هم‌راستا با اصلاح قبلی دیالوگ ویرایش تراکنش)
------------------------------------------------------------------ */
QMessageBox {
    background-color: #ffffff;
    font-family: Vazir, Arial;
}

QMessageBox QLabel {
    background-color: transparent;
    color: #1e293b;
    font-size: 13px;
    min-width: 260px;
}

QMessageBox QPushButton {
    min-width: 88px;
    padding: 7px 18px;
    font-family: Vazir, Arial;
    font-weight: bold;
}
